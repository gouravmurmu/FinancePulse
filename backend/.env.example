ENVIRONMENT=development
LOG_LEVEL=INFO
# Supabase: Project Settings -> Database -> Connection string -> Session pooler (IPv4).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketpulse
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Optional regex for preview deployments, e.g. ^https://marketpulse-.*\.vercel\.app$
CORS_ORIGIN_REGEX=
# Optional AI assistant: any OpenAI-compatible provider; defaults to Groq.
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
